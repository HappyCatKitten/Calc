#!/usr/bin/env bash
set -euo pipefail
app_root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
export LD_LIBRARY_PATH="$app_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$app_root/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$app_root/plugins/platforms"
export QML_IMPORT_PATH="$app_root/qml"
export QML2_IMPORT_PATH="$app_root/qml"
export QT_QUICK_CONTROLS_STYLE=Basic
exec "$app_root/brainfuck-calculator" "$@"
